// ─────────────────────────────────────────
// SHOW PAGE FUNCTION
// ─────────────────────────────────────────
void showPage(int pageIndex) {

    for (int i = 0; i < LED_COUNT; i++) {
        strip.setPixelColor(i, OFF);
    }

    LEDState* page = pages[pageIndex];
    int size = pageSizes[pageIndex];

    for (int i = 0; i < size; i++) {
        strip.setPixelColor(page[i].index, page[i].color);
    }

    strip.show();
}

// ─────────────────────────────────────────
// COMPASS & NEEDLE CONFIGURATION
// ─────────────────────────────────────────
// Adjust NORTH_OFFSET if needle points away from true North (e.g. 0, 90, 180, 270)
float NORTH_OFFSET = 0.0;

// Set to true so needle rotates opposite to device rotation (stays pointing North)
bool INVERT_ROTATION = true;

int headingToPage(float angle) {
    // Shift by half page width (7.2 deg) so Page 0 is centered on North (0 deg)
    angle += 7.2;

    while (angle >= 360.0) angle -= 360.0;
    while (angle < 0.0)    angle += 360.0;

    int page = (int)(angle / 14.4);
    if (page > 24) page = 24;
    if (page < 0)  page = 0;

    return page;
}

// ─────────────────────────────────────────
// COMPASS SETUP
// ─────────────────────────────────────────
QMC5883LCompass compass;

int lastPage = -1;
float PAGE_WIDTH = 14.4;



// ─────────────────────────────────────────
// DEBUG — prints raw values every interval
// ─────────────────────────────────────────
#define DEBUG_COMPASS  true
unsigned long lastDebugPrint = 0;
const unsigned long DEBUG_INTERVAL = 250; // ms

#include <Wire.h>

// Error LED indices to blink if QMC (0x0D) is not found
const int ERROR_LEDS[] = {3, 10, 22, 33, 52};
const int ERROR_LED_COUNT = sizeof(ERROR_LEDS) / sizeof(ERROR_LEDS[0]);

// ─────────────────────────────────────────
// I2C SCANNER / QMC DETECTION FUNCTION
// ─────────────────────────────────────────
bool isQMCConnected() {
    Wire.beginTransmission(0x0D);
    byte error = Wire.endTransmission();
    return (error == 0);
}

void blinkSensorError() {
    Serial.println("\n[ERROR] QMC5883L (0x0D) NOT DETECTED! Blinking error LEDs (3, 10, 22, 33, 52)...");
    
    // Loop and blink until sensor is detected
    while (!isQMCConnected()) {
        // All off
        for (int i = 0; i < LED_COUNT; i++) {
            strip.setPixelColor(i, OFF);
        }
        // Turn ON error LEDs in bright red
        for (int i = 0; i < ERROR_LED_COUNT; i++) {
            strip.setPixelColor(ERROR_LEDS[i], strip.Color(255, 0, 0));
        }
        strip.show();
        delay(400);

        // Turn OFF error LEDs
        for (int i = 0; i < ERROR_LED_COUNT; i++) {
            strip.setPixelColor(ERROR_LEDS[i], OFF);
        }
        strip.show();
        delay(400);

        Serial.println("  Waiting for QMC5883L at 0x0D... Check SDA/SCL/VCC/GND wiring.");
    }

    Serial.println("\n[OK] QMC5883L re-detected! Resuming setup...");
}

bool scanI2C() {
    Serial.println("\n--- Scanning I2C Bus ---");
    byte count = 0;
    bool qmcFound = false;
    Wire.begin();
    
    for (byte addr = 1; addr < 127; addr++) {
        Wire.beginTransmission(addr);
        byte error = Wire.endTransmission();
        if (error == 0) {
            Serial.print("  Found I2C device at address 0x");
            if (addr < 16) Serial.print("0");
            Serial.print(addr, HEX);
            if (addr == 0x0D) {
                Serial.println("  <-- QMC5883L detected!");
                qmcFound = true;
            } else if (addr == 0x1E) {
                Serial.println("  <-- HMC5883L / QMC clone detected (0x1E)!");
            } else {
                Serial.println();
            }
            count++;
        }
    }
    
    if (count == 0) {
        Serial.println("  *** ERROR: NO I2C DEVICES FOUND! ***");
    } else {
        Serial.print("--- I2C Scan Complete: Found ");
        Serial.print(count);
        Serial.println(" device(s) ---\n");
    }

    return qmcFound;
}

// ─────────────────────────────────────────
// CONTINUOUS AUTO-CALIBRATION
// ─────────────────────────────────────────
int xMin = 32767, xMax = -32768;
int yMin = 32767, yMax = -32768;
int zMin = 32767, zMax = -32768;

float cal_x_offset = 0.0, cal_y_offset = 0.0, cal_z_offset = 0.0;
float cal_x_scale  = 1.0, cal_y_scale  = 1.0, cal_z_scale  = 1.0;

void updateContinuousCalibration(int rawX, int rawY, int rawZ) {
    bool updated = false;

    if (rawX < xMin) { xMin = rawX; updated = true; }
    if (rawX > xMax) { xMax = rawX; updated = true; }
    if (rawY < yMin) { yMin = rawY; updated = true; }
    if (rawY > yMax) { yMax = rawY; updated = true; }
    if (rawZ < zMin) { zMin = rawZ; updated = true; }
    if (rawZ > zMax) { zMax = rawZ; updated = true; }

    if (updated) {
        cal_x_offset = (xMax + xMin) / 2.0;
        cal_y_offset = (yMax + yMin) / 2.0;
        cal_z_offset = (zMax + zMin) / 2.0;

        float x_range = xMax - xMin;
        float y_range = yMax - yMin;
        float z_range = zMax - zMin;
        float avg_range = (x_range + y_range + z_range) / 3.0;

        if (x_range > 50 && y_range > 50) {
            cal_x_scale = (x_range > 0) ? avg_range / x_range : 1.0;
            cal_y_scale = (y_range > 0) ? avg_range / y_range : 1.0;
            cal_z_scale = (z_range > 0) ? avg_range / z_range : 1.0;
        }
    }
}

// ─────────────────────────────────────────
// SETUP
// ─────────────────────────────────────────
void setup() {

    Serial.begin(115200);

    strip.begin();
    strip.setBrightness(BRIGHTNESS);
    strip.show();

    // Check if QMC5883L at 0x0D is connected; if not, blink error LEDs (3, 10, 22, 33, 52)
    if (!scanI2C()) {
        blinkSensorError();
    }

    compass.init();

    // Startup quick prime
    for (int i = 0; i < 10; i++) {
        compass.read();
        updateContinuousCalibration(compass.getX(), compass.getY(), compass.getZ());
        delay(10);
    }

    Serial.println("Compass ready - LEDs active immediately!");
    
    // Initial display
    showPage(0);
}

// ─────────────────────────────────────────
// LOOP
// ─────────────────────────────────────────
void loop() {

    compass.read();

    int rawX = compass.getX();
    int rawY = compass.getY();
    int rawZ = compass.getZ();

    // Dynamically expand min/max calibration in real time
    updateContinuousCalibration(rawX, rawY, rawZ);

    // Apply calibration
    float x = (rawX - cal_x_offset) * cal_x_scale;
    float y = (rawY - cal_y_offset) * cal_y_scale;
    float z = (rawZ - cal_z_offset) * cal_z_scale;

    // ── 1. Calculate device heading ──────────
    // atan2 gives angle of sensor relative to magnetic field
    float deviceHeading = atan2(y, x) * 180.0 / PI;
    if (deviceHeading < 0)
        deviceHeading += 360.0;

    // ── 2. Calculate needle angle ────────────
    // For needle to stay fixed pointing North: needle must rotate opposite to device
    float needleAngle;
    if (INVERT_ROTATION) {
        needleAngle = 360.0 - deviceHeading + NORTH_OFFSET;
    } else {
        needleAngle = deviceHeading + NORTH_OFFSET;
    }

    // Keep within [0, 360)
    while (needleAngle >= 360.0) needleAngle -= 360.0;
    while (needleAngle < 0.0)    needleAngle += 360.0;

    // ── 3. Map needle angle directly to page ─
    int page = headingToPage(needleAngle);

    // ── 4. Debug output ──────────────────────
    if (DEBUG_COMPASS) {
        unsigned long now = millis();
        if (now - lastDebugPrint >= DEBUG_INTERVAL) {
            lastDebugPrint = now;

            Serial.print("Device Heading: ");
            Serial.print(deviceHeading, 1);
            Serial.print((char)176);
            Serial.print("  |  Needle Angle: ");
            Serial.print(needleAngle, 1);
            Serial.print((char)176);
            Serial.print("  |  Page: ");
            Serial.println(page);
        }
    }

    // ── 5. Update display on page change ─────
    if (page != lastPage) {
        showPage(page);
        lastPage = page;

        Serial.print(">>> [PAGE ");
        Serial.print(page);
        Serial.print("] Needle: ");
        Serial.print((int)needleAngle);
        Serial.print((char)176);
        Serial.print(" (Device Heading: ");
        Serial.print((int)deviceHeading);
        Serial.println((char)176);
    }

    delay(30);
}
